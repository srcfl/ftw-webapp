{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    // "node" because the repo now has a server in relay/ and tests that start
    // it. Browser code stays honest by writing ReturnType<typeof setTimeout>
    // rather than assuming either platform's timer type.
    "types": ["vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "isolatedModules": true,
    "resolveJsonModule": true,
    // Vitest's native config loader requires the extension on relative
    // imports; safe here because nothing is emitted.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,

    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$vendor/*": ["src/vendor/*"],
      "$views/*": ["src/views/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "relay/**/*.ts", "*.config.ts"]
}
